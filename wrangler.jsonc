{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kravmagaputignano",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-10-12",
  "workers_dev": true,
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page"
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  }
}
